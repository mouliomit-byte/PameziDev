# Copiez ce fichier en « .env » pour brancher l'application sur votre serveur Pamezi.
# Sans cette variable, l'application tourne en mode démonstration (données sur l'appareil).
# EXPO_PUBLIC_API_URL=https://api.pamezi.cm
# EXPO_PUBLIC_EDITION=client   # client (abonnés), gestion (back office) ; vide = les deux
